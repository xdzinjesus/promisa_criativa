# Na Vercel, cadastre em Settings > Environment Variables.
ADMIN_PASSWORD=
# Gere um segredo aleatório (mínimo de 32 caracteres), diferente da senha.
ADMIN_SESSION_SECRET=
SITE_URL=https://seu-dominio.com.br
# Token do Vercel Blob PRIVADO conectado ao projeto. Nunca use prefixo NEXT_PUBLIC.
BLOB_READ_WRITE_TOKEN=
