{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/((?!demo/).*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action https://wa.me; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action https://wa.me; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/privacidade.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action https://wa.me; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action https://wa.me; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/acesso.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/briefing.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/acesso.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/access.js": {
      "includeFiles": "private/**"
    },
    "api/cloud.js": {
      "maxDuration": 60
    },
    "api/maintenance.js": {
      "maxDuration": 60
    },
    "api/demo.js": {
      "maxDuration": 30
    },
    "api/briefing.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/api/access?view=admin"
    },
    {
      "source": "/catalogo",
      "destination": "/api/access?view=catalogo"
    },
    {
      "source": "/briefing/:token",
      "destination": "/briefing.html"
    },
    {
      "source": "/briefing/:token/",
      "destination": "/briefing.html"
    },
    {
      "source": "/demo/:token",
      "destination": "/api/demo?token=:token"
    },
    {
      "source": "/demo/:token/",
      "destination": "/api/demo?token=:token"
    },
    {
      "source": "/demo/:token/:path+",
      "destination": "/api/demo?token=:token&path=:path+"
    },
    {
      "source": "/demo/:token/:path+/",
      "destination": "/api/demo?token=:token&path=:path+/"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance",
      "schedule": "0 6 * * *"
    }
  ]
}
